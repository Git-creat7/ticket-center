# JMeter 压测运行时明细日志与阶段产物
benchmark/results/
benchmark/results_*/

# JMeter 生成产物：HTML 报告内含大量第三方静态资源，token 由 generate_tokens.py 现生成
benchmark/reports/
benchmark/jmeter_tokens.csv

# 直接在 benchmark/ 下跑单个 .jmx 时落的原始样本与 rtt_probe.sh 的输出
benchmark/*.jtl
benchmark/*.log
benchmark/rtt_probe_*.txt
