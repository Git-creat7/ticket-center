<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="asia.creat.mapper.TicketStockMapper">

    <select id="selectForUpdate" resultType="asia.creat.entity.TicketStock">
        SELECT *
        FROM tb_ticket_stock
        WHERE ticket_id = #{ticketId}
        FOR UPDATE
    </select>
</mapper>
