# 复制为 .env 后填写本机 Docker 服务凭据。
# .env 已被 Git 忽略，不要把真实值写入本文件。
DB_PASSWORD=
TICKET_REDIS_PASSWORD=
# Sentinel profile settings. Set SPRING_PROFILES_ACTIVE=sentinel when using Sentinel.
# SPRING_PROFILES_ACTIVE=sentinel
TICKET_REDIS_MASTER=mymaster
TICKET_REDIS_SENTINELS=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
TICKET_REDIS_SENTINEL_USERNAME=
TICKET_REDIS_SENTINEL_PASSWORD=
TICKET_RABBITMQ_USERNAME=
TICKET_RABBITMQ_PASSWORD=

# OSS 可选；不开启时不影响项目启动。
TICKET_OSS_ENABLED=false

# 压测脚本 benchmark/run_all_benchmarks.ps1 使用；JMETER_BIN 不填则取 PATH 中的 jmeter.bat。
DB_USERNAME=root
JMETER_BIN=
