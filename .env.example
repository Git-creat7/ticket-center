# ====================================================================
# Ticket Center - 环境变量配置模板
# ====================================================================
# 复制为 .env 后填写实际值。.env 已被 Git 忽略，不要把真实密码写入本文件。

# -------------------- 必填项 --------------------

# MySQL root 密码和应用账号密码（必填）
DB_PASSWORD=

# 应用账号，Compose 启动时自动创建并授权。
DB_USERNAME=ticket_core
ORDER_DB_USERNAME=ticket_order

# Redis 密码（必填）
TICKET_REDIS_PASSWORD=

# RabbitMQ 用户名和密码（必填）
TICKET_RABBITMQ_USERNAME=
TICKET_RABBITMQ_PASSWORD=

# 服务间调用凭据，填写随机字符串，两个业务服务保持一致。
TICKET_INTERNAL_TOKEN=

# -------------------- 可选项 --------------------

# 宿主机端口映射（可选，默认值如下）
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672
# Gateway 统一入口，前端和压测脚本都使用这个端口。
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=5173
CORE_HOST_PORT=8082
ORDER_HOST_PORT=8083
NACOS_HOST_PORT=8848
NACOS_GRPC_HOST_PORT=9848
# Nacos 命名空间 ID，留空表示 public。
NACOS_NAMESPACE=

# 镜像仓库（线上只拉取镜像，不执行 Dockerfile 构建）
TICKET_IMAGE_REPOSITORY=ghcr.io/git-creat7/ticket-center
TICKET_IMAGE_TAG=latest

# OSS 配置（可选，不开启时不影响项目启动）
TICKET_OSS_ENABLED=false
TICKET_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
TICKET_OSS_BUCKET=
TICKET_OSS_PUBLIC_DOMAIN=
TICKET_OSS_OBJECT_PREFIX=uploads
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
TICKET_OSS_SECURITY_TOKEN=
# 本机可填写 Alibaba Cloud CLI 配置中的 profile。
# 容器部署不读取本机 CLI 配置，请填写上面的 AccessKey。
TICKET_OSS_CLI_PROFILE=
